{
  "device": "cuda",
  "seed": 42,
  "checkpoint_dir": "checkpoints",
  "log_dir": "logs",
  "environment": {
    "sumo_cfg": "仿真环境_初赛_1.0/仿真环境-初赛/sumo.sumocfg",
    "net_file": "仿真环境_初赛_1.0/仿真环境-初赛/net.xml",
    "route_file": "仿真环境_初赛_1.0/仿真环境-初赛/routes.xml",
    "step_length": 0.1,
    "max_steps": 3600,
    "control_ratio": 0.25,
    "use_gui": false
  },
  "model": {
    "node_dim": 9,
    "edge_dim": 4,
    "gnn_hidden_dim": 128,
    "gnn_output_dim": 256,
    "gnn_layers": 4,
    "gnn_heads": 8,
    "gnn_dropout": 0.15,
    "world_hidden_dim": 512,
    "world_num_layers": 4,
    "future_steps": 5,
    "world_dropout": 0.2,
    "world_bidirectional": true,
    "controller_hidden_dim": 256,
    "global_dim": 16,
    "action_dim": 2,
    "top_k": 5,
    "controller_dropout": 0.2,
    "interaction_radius": 100.0,
    "max_neighbors": 8,
    "lane_change_distance": 50.0,
    "ttc_threshold": 2.0,
    "thw_threshold": 1.5,
    "max_accel": 2.0,
    "max_decel": -3.0,
    "emergency_decel": -5.0,
    "max_lane_change_speed": 5.0,
    "cost_limit": 0.1,
    "initial_lambda": 1.0,
    "lambda_lr": 0.01
  },
  "phase1": {
    "num_episodes": 10,
    "epochs": 50,
    "batch_size": 512,
    "lr": 3e-4,
    "weight_decay": 1e-4,
    "data_collection_timeout": 180,
    "num_parallel_workers": 16,
    "gradient_clip": 1.0,
    "warmup_epochs": 5,
    "phase1_model_path": "models/world_model_phase1.pth",
    "use_mixed_precision": true,
    "use_fast_graph": true,
    "accumulate_grad_batches": 1
  },
  "phase2": {
    "num_envs": 2,
    "total_timesteps": 10000,
    "lr": 3e-4,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "batch_size": 512,
    "n_epochs": 10,
    "n_steps": 2048,
    "phase2_model_path": "models/ppo_phase2.pth"
  },
  "phase3": {
    "total_timesteps": 50000,
    "lr": 1e-4,
    "freeze_bn": true,
    "phase3_model_path": "models/e2e_phase3.pth"
  },
  "phase4": {
    "total_timesteps": 30000,
    "cost_limit": 0.1,
    "lr": 1e-4,
    "final_model_path": "models/final_model.pth"
  },
  "evaluation": {
    "num_episodes": 5,
    "output_dir": "results"
  }
}